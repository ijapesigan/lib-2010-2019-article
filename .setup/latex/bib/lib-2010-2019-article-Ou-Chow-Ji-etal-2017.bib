@Article{Ou-Chow-Ji-etal-2017,
  author = {Lu Ou and Sy-Miin Chow and Linying Ji and Peter C. M. Molenaar},
  date = {2017},
  journaltitle = {Multivariate Behavioral Research},
  title = {{(Re)}evaluating the implications of the autoregressive latent trajectory model through likelihood ratio tests of its initial conditions},
  doi = {10.1080/00273171.2016.1259980},
  issn = {1532-7906},
  number = {2},
  pages = {178--199},
  volume = {52},
  publisher = {Informa UK Limited},
  abstract = {The autoregressive latent trajectory model combines autoregressive and latent growth components and can imply substantially different forms of longitudinal change under different specifications. This flexibility has also produced difficulties in interpreting its parameters. The authors show that several of these interpretational issues can be clarified by examining and testing assumptions concerning the model's initial conditions. Mathematical derivations establish nested relationships among three variants of the autoregressive latent trajectory model and identify the constraints required for their equivalence. Monte Carlo simulations indicate that likelihood ratio tests, particularly when considered together with information criteria, can be used to evaluate targeted hypotheses about the form of the underlying change process. An empirical analysis of longitudinal family income data from 3,995 participants illustrates how tests of initial conditions can improve interpretation of autoregressive latent trajectory models.},
}
