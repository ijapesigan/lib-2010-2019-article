@Article{Lindsay-Chin-Greco-etal-2018,
  author       = {Lindsay, Emily K. and Chin, Brian and Greco, Carol M. and Young, Shinzen and Brown, Kirk W. and Wright, Aidan G. C. and Smyth, Joshua M. and Burkett, Deanna and Creswell, J. David},
  date         = {2018-12},
  journaltitle = {Journal of Personality and Social Psychology},
  title        = {How mindfulness training promotes positive emotions: Dismantling acceptance skills training in two randomized controlled trials},
  doi          = {10.1037/pspa0000134},
  issn         = {0022-3514},
  number       = {6},
  pages        = {944--973},
  volume       = {115},
  publisher    = {American Psychological Association (APA)},
  abstract     = {Mindfulness interventions typically combine monitoring of present-moment experience with an accepting orientation toward those experiences. Two randomized controlled trials tested whether acceptance training is specifically necessary for increasing positive emotion. Mindfulness training was dismantled into interventions that taught both monitoring and acceptance skills or monitoring skills alone. The first study compared eight-week group-based interventions with a no-treatment control, whereas the second compared two-week smartphone-based interventions with an active control. Ambulatory assessments measured positive and negative affect before and after training. Across both studies, training that combined monitoring with acceptance increased positive affect relative to monitoring-only and control conditions. In contrast, the active interventions generally reduced negative affect regardless of acceptance training. These findings identify acceptance of present-moment experiences as an important mechanism through which mindfulness training may enhance positive emotions in daily life.},
}
