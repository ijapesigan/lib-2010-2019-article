@Article{Fredrickson-Joiner-2018,
  author = {Barbara L. Fredrickson and Thomas Joiner},
  date = {2018-03},
  journaltitle = {Perspectives on Psychological Science},
  title = {Reflections on positive emotions and upward spirals},
  abstract = {The authors reflect on their 2002 article on positive emotions and upward spirals and its influence within and beyond psychological science. They review empirical and theoretical advances in understanding upward spiral dynamics, with particular attention to the upward spiral theory of lifestyle change. They argue for deeper and more rigorous tests of prospective and reciprocal relations involving positive emotions to improve theory, translation, and applications for health and well-being.},
  doi = {10.1177/1745691617692106},
  issn = {1745-6924},
  number = {2},
  pages = {194--199},
  volume = {13},
  publisher = {SAGE Publications},
}
