@Article{Boker-2015,
  author = {Steven M. Boker},
  date = {2015-02},
  journaltitle = {Journal for Person-Oriented Research},
  title = {Adaptive equilibria: A balancing act of regulation in development},
  doi = {10.17505/jpor.2015.10},
  issn = {2002-0244},
  number = {1-2},
  pages = {99--109},
  volume = {1},
  publisher = {Journal for Person-Oriented Research},
  abstract = {Equilibrium can be understood as a balance between changing environmental forces and within-person processes. This article distinguishes an equilibrium produced by the immediate balancing of forces from a preferred equilibrium toward which a system adapts more gradually. The proposed framework separates regulation into two timescales: fast regulation that automatically balances ongoing forces and slower adaptation that reorganizes the fast regulatory process when environmental influences persist. This distinction provides a basis for modeling the interplay among behavior, learning, and development across multiple timescales.},
}
